# Keep generated results local unless intentionally publishing a frozen run.
real_data/
real_results/
greatlake/
plots/

# Local paper sources, figures, PDFs, and LaTeX build artifacts.
# Keep configs/paper.json tracked: it is an experiment configuration.
/paper/

# Historical code and study archives are retained locally, not synchronized.
/archive/
