__pycache__/
*.py[cod]

.venv/
venv/
.cache/

# Machine-local artifacts.  No trailing slash on runs/results/logs so the
# rules also match Delta symlinks, not only ordinary directories.
/downloads
/logs
/runs
/results
/runs.home-backup-*
/results.home-backup-*
